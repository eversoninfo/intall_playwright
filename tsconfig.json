
{
  "compilerOptions": {
    
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
    
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "playwright.config.ts"]
}
